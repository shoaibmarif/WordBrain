{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/random",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/play",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/daily-challenge",
      "destination": "/daily",
      "permanent": true
    },
    {
      "source": "/speed-run",
      "destination": "/timed",
      "permanent": true
    },
    {
      "source": "/rules",
      "destination": "/how-to-play",
      "permanent": true
    },
    {
      "source": "/tips",
      "destination": "/strategies",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/daily",
      "destination": "/daily.html"
    },
    {
      "source": "/practice",
      "destination": "/practice.html"
    },
    {
      "source": "/timed",
      "destination": "/timed.html"
    },
    {
      "source": "/how-to-play",
      "destination": "/how-to-play.html"
    },
    {
      "source": "/strategies",
      "destination": "/strategies.html"
    },
    {
      "source": "/starting-words",
      "destination": "/starting-words.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/sitemap",
      "destination": "/sitemap.html"
    },
    {
      "source": "/5-letter-word-game",
      "destination": "/5-letter-word-game.html"
    },
    {
      "source": "/6-letter-word-game",
      "destination": "/6-letter-word-game.html"
    },
    {
      "source": "/7-letter-word-game",
      "destination": "/7-letter-word-game.html"
    },
    {
      "source": "/8-letter-word-game",
      "destination": "/8-letter-word-game.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/words/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
